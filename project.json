{
  "langrev": "1",
  "warnings": [
    "no-unused-parameter",
    "no-unused-import"
  ],
  "targets": {
    "ted": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/command_bar.c3",
        "src/file_search.c3",
        "test/**",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3"
      ],
      "opt": "Os",
      "strip-unused": true
    },
    "ted-gui": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/command_bar.c3",
        "src/file_search.c3",
        "test/**",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3",
        "src/gui_main.c3"
      ],
      "features": [
        "MILKTEA_GUI"
      ],
      "dependencies": [
        "milktea_gui"
      ],
      "opt": "Os",
      "strip-unused": true,
      "macos-min-version": "14.0"
    }
  },
  "dependency-search-paths": [
    "lib/milktea/lib",
    "lib"
  ],
  "dependencies": [
    "ink",
    "milktea"
  ]
}
