{
  "langrev": "1",
  "warnings": [
    "no-unused-parameter",
    "no-unused-import"
  ],
  "targets": {
    "ted": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3"
      ],
      "opt": "Os",
      "strip-unused": true
    },
    "ted-gui": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3",
        "src/chrome.c3",
        "src/gui_main.c3",
        "vendor/milktea/milktea-gui/**"
      ],
      "c-sources": [
        "vendor/milktea/milktea-gui/macos_window.c"
      ],
      "features": [
        "MILKTEA_GUI"
      ],
      "dependencies": [
        "raylib6"
      ],
      "opt": "Os",
      "strip-unused": true
    }
  },
  "dependency-search-paths": [
    "vendor",
    "vendor/milktea",
    "vendor/milktea/lib"
  ],
  "dependencies": [
    "ink",
    "milktea",
    "glaze",
    "xray",
    "boba"
  ]
}
