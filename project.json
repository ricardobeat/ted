      ],
      "c-sources": [
        "vendor/milktea/milktea/tty_winsize.c",
        "vendor/milktea/milktea-gui/macos_window.c"
      ],
      "features": [
        "MILKTEA_GUI"
      ],
      "dependency-search-paths": [
        "vendor/milktea"
      ],
      "dependencies": [
        "raylib6"
      ],
      "opt": "Os",
      "strip-unused": true
    }
  }
