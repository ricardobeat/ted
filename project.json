{
  "langrev": "1",
  "warnings": [
    "no-unused-parameter",
    "no-unused-import"
  ],
  "targets": {
    "ted": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/command_bar.c3",
        "src/file_search.c3",
        "test/**",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3"
      ],
      "opt": "Os",
      "strip-unused": true
    },
    "ted-gui": {
      "type": "executable",
      "sources": [
        "src/editor/**",
        "src/theme.c3",
        "src/button.c3",
        "src/dialog.c3",
        "src/command_bar.c3",
        "src/file_search.c3",
        "test/**",
        "src/menu.c3",
        "src/sidebar.c3",
        "src/syntax.c3",
        "src/ted.c3",
        "src/chrome.c3",
        "src/gui_main.c3",
        "lib/milktea/milktea-gui/**"
      ],
      "c-sources": [
        "lib/milktea/milktea-gui/macos_window.c",
        "lib/milktea/vendor/plutovg/src/plutovg-blend.c",
        "lib/milktea/vendor/plutovg/src/plutovg-canvas.c",
        "lib/milktea/vendor/plutovg/src/plutovg-font.c",
        "lib/milktea/vendor/plutovg/src/plutovg-ft-math.c",
        "lib/milktea/vendor/plutovg/src/plutovg-ft-raster.c",
        "lib/milktea/vendor/plutovg/src/plutovg-ft-stroker.c",
        "lib/milktea/vendor/plutovg/src/plutovg-matrix.c",
        "lib/milktea/vendor/plutovg/src/plutovg-paint.c",
        "lib/milktea/vendor/plutovg/src/plutovg-path.c",
        "lib/milktea/vendor/plutovg/src/plutovg-rasterize.c",
        "lib/milktea/vendor/plutovg/src/plutovg-surface.c"
      ],
      "c-include-dirs": [
        "lib/milktea/vendor/plutovg/include"
      ],
      "cflags": "-DPLUTOVG_DISABLE_IMAGE_WRITE",
      "features": [
        "MILKTEA_GUI"
      ],
      "dependencies": [
        "raylib6"
      ],
      "opt": "Os",
      "strip-unused": true
    }
  },
  "dependency-search-paths": [
    "lib/milktea/lib",
    "lib"
  ],
  "dependencies": [
    "ink",
    "dye",
    "milktea",
    "glaze",
    "xray",
    "boba"
  ]
}
